# InfiniAnalytics agent settings. `enroll` writes the first three for you into
# /var/lib/infinianalytics-agent/agent.env (Linux) or
# %ProgramData%\InfiniAnalytics Agent\agent.env (Windows). Every value below
# except those three is the built-in default. Environment variables of the
# same name take precedence over this file.

# Identity - written by `infinianalytics-agent enroll <code>`. Keep the key secret.
#IA_AGENT_URL=https://api.analytics.infini.es
#IA_AGENT_SERVER_ID=
#IA_AGENT_KEY=

# Sampling: vitals every 2 s, summarised into 10 s windows (pushed every 10 s).
IA_AGENT_SAMPLE_INTERVAL=2
IA_AGENT_WINDOW=10
IA_AGENT_FS_INTERVAL=60

# What could not be delivered is kept on disk, up to both limits (oldest dropped first).
IA_AGENT_SPOOL_MAX_AGE=172800
IA_AGENT_SPOOL_MAX_MB=50

# Docker containers: the busiest N per window (by CPU + memory), plus the
# event stream (crashes, OOM kills, restarts, deploys). false turns both off.
IA_AGENT_DOCKER=true
IA_AGENT_CONTAINER_LIMIT=50
IA_AGENT_DOCKER_CONCURRENCY=4
# Defaults to DOCKER_HOST, then the local socket / Docker Desktop pipe.
#IA_AGENT_DOCKER_HOST=unix:///var/run/docker.sock

# Filesystems: "auto" is / plus every drive under /mnt on Linux, every fixed
# drive on Windows. Add paths or label=path entries: auto,/data,backups=/srv/backups
IA_AGENT_FS_ROOTS=auto

# Where the spool and state.json live (default: this file's folder).
#IA_AGENT_STATE_DIR=

# Only for machines cloned from one image that share /etc/machine-id: give
# each one its own id before enrolling.
#IA_AGENT_MACHINE_ID=
